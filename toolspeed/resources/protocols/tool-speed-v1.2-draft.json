      "primary_attribution_baseline": "DAGScheduler_serial_ablation",
      "practical_baseline": "NativeParallelScheduler",
      "informational_baselines": ["SyncReActScheduler"],
      "status": "ACTIVE",
      "thresholds": {
        "min_p95_speedup_efficacy": 1.20,
        "min_candidate_success_rate": 0.95,
        "max_allowable_success_drop": 0.00,
        "min_p99_speedup_non_regression": 0.95,
        "max_cost_multiplier": 1.05,
        "max_unapproved_side_effects": 0,
        "max_duplicate_commits": 0
