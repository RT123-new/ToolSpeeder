{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "plan_id": "tool-speed-v1.2-draft",
  "plan_version": "1.2.0-draft",
  "status": "draft",
  "is_frozen": false,
  "description": "Draft benchmark protocol specification v1.2 incorporating machine-evaluable statistical rules, true identity negative controls, and separated W7 safety and latency mechanisms.",
  "workload_fixture_version": "1.2.0",
  "required_metric_policy_version": "2.2.0",
  "evidence_levels": [
    "replay_integration",
    "local_wall_clock"
  ],
  "seeds": [
    42,
    137,
    2026
  ],
  "trials_per_seed": {
    "replay_integration": 1000,
    "local_wall_clock": 200
  },
  "smoke_trials_per_seed": 10,
  "timing_sources": {
    "replay_integration": "virtual_clock",
    "local_wall_clock": "monotonic_wall_clock"
  },
  "warmup_policy": {
    "trials": 5,
    "symmetric": true,
    "isolated": true,
    "excluded_from_evidence": true
  },
  "statistical_rules": {
    "bootstrap_resamples": 2000,
    "bootstrap_ci": 0.95,
    "confidence_bound_rule": "one_sided_lower_bound_exceeds_threshold",
    "pairing_rule": "stratified_paired_index_bootstrap",
    "multiplicity_policy": "holm_bonferroni"
  },
  "missing_data_rule": "strict_fail_closed_inconclusive",
  "failure_handling": {
    "unsuccessful_trial_ccl_policy": "conditional_on_both_success",
    "success_rate_difference_test": "paired_difference_ci_lower_bound_non_inferior"
  },
  "cost_rule": "candidate_cost_over_baseline_under_threshold",
  "safety_rule": "zero_unapproved_zero_duplicate_exact_state_diff",
  "stop_rule": "deterministic_complete_trial_matrix",
  "amendment_process": "new_version_with_unbroken_history_and_rationale",
  "central_hypothesis": {
    "name": "ToolSpeeder Mechanism Attribution and Latency Efficacy",
    "description": "Every active candidate mechanism significantly reduces P95 CCL over its pre-registered primary attribution baseline without safety violations, cost divergence, or success rate drops.",
    "aggregation_rule": "conjunction_all_primary_mechanisms"
  },
  "amendment_ledger": [
    {
      "version": "1.2.0-draft",
      "date": "2026-09-02",
      "changes": [
        "Replaced free-form rule strings with structured machine-evaluable fields for timing sources, confidence bounds, and trial matrices.",
        "Formalized true identity negative controls across identical scheduler configurations.",
        "Mandated real executed positive sensitivity controls measuring latency perturbation.",
        "Decoupled E5a codec transport benchmarks from full agent reasoning runs.",
        "Enforced 3 preregistered seeds (42, 137, 2026) required for all confirmatory runs."
      ]
    }
  ],
