  "controls": {
    "negative_controls": [
      {
        "id": "E1_identity_control",
        "description": "True identity comparison: DAGScheduler(parallel=True) vs DAGScheduler(parallel=True) with identical fixtures and cloned state",
        "expected_p95_speedup_range": [0.95, 1.05]
      },
      {
        "id": "E2_identity_control",
        "description": "True identity comparison: JITFusionScheduler vs JITFusionScheduler with identical fixtures and cloned state",
        "expected_p95_speedup_range": [0.95, 1.05]
      },
      {
        "id": "E3_identity_control",
