  "amendment_ledger": [
    {
      "version": "1.1.1",
      "date": "2026-09-02",
      "changes": [
        "Reclassified status from prospectively_frozen to retrospective_repair to honestly reflect that v1.1 was finalized during integrity repair rather than prior to preliminary code exploration."
      ]
    },
    {
      "version": "1.1.0",
      "date": "2026-08-29",
      "changes": [
        "Established explicit dual-comparison structure: primary attribution baseline (isolating isolated mechanism ablation) and practical baseline (comparing candidate against standard agent / scheduler).",
        "Split W7 into W7_SAFETY (mandatory safety gate: zero unapproved side-effects, zero duplicate mutations, 100% success rate) and W7_LATENCY (measuring preparation overlap latency vs identical reference path).",
        "Defined negative controls as true identity controls with identical baseline and candidate arms evaluating the null effect region [0.95x, 1.05x].",
        "Replaced hardcoded positive sensitivity control with genuine delayed runtime tool execution (injected 50% delay, expected ~2.00x speedup in range [1.80x, 2.20x]).",
        "Bound E5a codec transport evaluation directly to JSON codec comparison and marked E5b action token generation as UNIMPLEMENTED / INCONCLUSIVE.",
        "Enforced strict JSON schema validation and canonical artifact bundle hashing (manifest.json, protocol.json, protocol-amendments.json, cases.jsonl, baseline-traces.jsonl, candidate-traces.jsonl, control-traces.jsonl, statistics.json, verdict.json, result.json, report.md, report.html, bundle.sha256)."
      ]
    }
  ],
